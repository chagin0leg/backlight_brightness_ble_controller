[Unit]
Description=Backlight BLE HIL stack
Wants=network-online.target docker.service
After=network-online.target docker.service backlight-stack.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/backlight-stack/deploy
ExecStart=/usr/bin/bash /opt/backlight-stack/deploy/run-hil.sh
ExecStop=/usr/bin/bash /opt/backlight-stack/deploy/stop-hil.sh
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
