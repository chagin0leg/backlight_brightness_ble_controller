# Network binding
LOCAL_DASHBOARD_NAME=backlight
LAN_BIND_IP=0.0.0.0
GATEWAY_BIND_PORT=18080
CADDY_BIND_PORT=80

# Security and auth
AUTH_SUBJECT_SALT=change-this-salt
TELEGRAM_BOT_TOKEN=
AUTH_DEVICE_SESSION_TTL_SEC=300

# Optional diagnostics protection
DIAGNOSTICS_INGEST_API_KEY=

# Optional hint for client-side redirect after /auth/callback
APP_REDIRECT_BASE=

# Google OAuth defaults (editable from local web UI as well)
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_AUTO_REDIRECT_FROM_PUBLIC_URL=true
GOOGLE_SCOPE=openid email profile
GOOGLE_PROMPT=consent
GOOGLE_ALLOWED_DOMAIN=
GOOGLE_REQUIRE_VERIFIED_EMAIL=true

# Optional: Cloudflare tunnel token for `--profile tunnel`
CLOUDFLARED_TOKEN=

# Auto-start temporary trycloudflare URL when CLOUDFLARED_TOKEN is empty
ENABLE_TRYCLOUDFLARE=true
