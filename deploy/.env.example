# Public bind ports (localhost only)
GATEWAY_BIND_PORT=18080
CADDY_BIND_PORT=18081

# Security and auth
AUTH_SUBJECT_SALT=change-this-salt
TELEGRAM_BOT_TOKEN=
AUTH_DEVICE_SESSION_TTL_SEC=300

# Optional diagnostics protection
DIAGNOSTICS_INGEST_API_KEY=

# Optional hint for client-side redirect after /auth/callback
APP_REDIRECT_BASE=

# Optional: Cloudflare tunnel token for `--profile tunnel`
CLOUDFLARED_TOKEN=
