{$LOCAL_DASHBOARD_NAME:backlight}.local {
  encode zstd gzip

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }

  reverse_proxy gateway:8080
}

:80 {
  encode zstd gzip

  @api path /health /auth/* /diagnostics/* /profiles/*
  handle @api {
    reverse_proxy gateway:8080
  }

  respond "Backlight console is available at http://{$LOCAL_DASHBOARD_NAME:backlight}.local" 404
}
